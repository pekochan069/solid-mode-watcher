{
  "name": "solid-mode-watcher",
  "version": "0.0.2",
  "private": false,
  "description": "Mode Watcher for Solid.js applications",
  "keywords": [
    "solid"
  ],
  "homepage": "https://github.com/pekochan069/solid-mode-watcher#readme",
  "bugs": {
    "url": "https://github.com/pekochan069/solid-mode-watcher/issues"
  },
  "license": "MIT",
  "author": "pekochan069",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pekochan069/solid-mode-watcher.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "typesVersions": {},
  "exports": {
    "solid": {
      "development": "./dist/dev.jsx",
      "import": "./dist/index.jsx"
    },
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      }
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "publish:prepare": "bun run build && bun pm pack --destination ./publish"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.0.2",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.2.4",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13"
}

{
  "name": "solid-mode-watcher",
  "version": "1.0.0-next",
  "private": false,
  "description": "Mode Watcher for Solid.js applications",
  "keywords": [
    "solid"
  ],
  "homepage": "https://github.com/pekochan069/solid-mode-watcher#readme",
  "bugs": {
    "url": "https://github.com/pekochan069/solid-mode-watcher/issues"
  },
  "license": "MIT",
  "author": "pekochan069",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pekochan069/solid-mode-watcher.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "typesVersions": {},
  "exports": {
    "solid": {
      "development": "./dist/dev.jsx",
      "import": "./dist/index.jsx"
    },
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      }
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "publish:prepare": "bun run build && bun pm pack --destination ./publish"
  },
  "devDependencies": {
    "@solidjs/web": "^2.0.0-rc.17",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "solid-js": "^2.0.0-rc.17",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^3.0.0-next.27"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.1",
    "solid-js": "^2.0.0-rc.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4"
}
